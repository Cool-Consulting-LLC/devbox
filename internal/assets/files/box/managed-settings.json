{
  "autoUpdatesChannel": "stable",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(devbox apply *)",
      "Bash(devbox destroy *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,
  "statusLine": {
    "type": "command",
    "command": "/usr/local/bin/devbox-claude-statusline",
    "refreshInterval": 60
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/guard.sh" }
        ]
      },
      { "matcher": "*", "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/claude-activity.sh" } ] }
    ],
    "UserPromptSubmit": [ { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/claude-activity.sh" } ] } ],
    "PostToolUse": [ { "matcher": "*", "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/claude-activity.sh" } ] } ],
    "Notification": [ { "matcher": "permission_prompt", "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/claude-activity.sh" } ] } ],
    "Stop": [ { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/claude-activity.sh" } ] } ],
    "StopFailure": [ { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/claude-activity.sh" } ] } ],
    "SessionEnd": [ { "hooks": [ { "type": "command", "command": "/etc/claude-code/hooks/claude-activity.sh" } ] } ]
  }
}
