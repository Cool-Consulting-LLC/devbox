{
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(devbox apply *)",
      "Bash(devbox destroy *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,
  "statusLine": {
    "type": "command",
    "command": "/usr/local/bin/devbox-claude-statusline",
    "refreshInterval": 60
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "/etc/claude-code/hooks/guard.sh" }
        ]
      }
    ]
  }
}
