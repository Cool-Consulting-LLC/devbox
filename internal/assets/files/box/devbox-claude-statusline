#!/bin/bash
# Claude Code statusLine. On the box, managed settings point every session at
# /usr/local/bin/devbox-claude-statusline; in the devbox repo, .claude/statusline.sh
# is a symlink to this file. Reads the session JSON on stdin and prints one line.
#
#   acme-api ⎇ main* ↑1  RC  gcp:client-a  aws:acme
#   8%  31% 12% 20%  $0.42 12m +80/-12  Fable 5.1
#
# Segments, each omitted when it does not apply, never an error:
#   - the repo being worked on (its name cut to its last 7 characters) and
#     its git state, or at a project root that is not a repo, no name, just
#     how many repos it holds and how many have changes
#   - RC: green while Remote Control is connected, red while it is off.
#     Claude Code sets CLAUDE_CODE_BRIDGE_SESSION_ID for exactly as long as
#     it is connected, and this inherits it
#   - gcp:NAME and aws:NAME: the gcloud config and AWS account the session
#     uses, when they have credentials; red when a project names one that has
#     none yet
#   - on the box: how full /srv/code is, unlabelled (the alert fires at
#     disk_used_pct)
#   - context window, 5-hour and 7-day rate-limit meters, unlabelled, in that
#     order; session cost, wall time and lines changed; and the model
# Needs jq.

input=$(cat)

# One jq call for every field. Missing fields come back empty. The separator
# is the ASCII unit separator: a whitespace IFS would collapse empty fields.
IFS=$'\x1f' read -r model cwd project_dir ctx_used five five_reset week cost dur_ms added removed <<<"$(
  jq -r '[
    (.model.display_name // ""),
    (.workspace.current_dir // .cwd // ""),
    (.workspace.project_dir // ""),
    (.context_window.used_percentage // ""),
    (.rate_limits.five_hour.used_percentage // ""),
    (.rate_limits.five_hour.resets_at // ""),
    (.rate_limits.seven_day.used_percentage // ""),
    (.cost.total_cost_usd // ""),
    (.cost.total_duration_ms // ""),
    (.cost.total_lines_added // ""),
    (.cost.total_lines_removed // "")
  ] | map(tostring) | join("\u001f")' <<<"$input"
)"

# When the 5-hour window resets and how full the week is, for
# devbox-claude-resume. Hooks are not told either.
if [[ $five_reset =~ ^[0-9]+$ ]] && mkdir -p "$HOME/.cache/devbox" 2>/dev/null; then
  echo "$five_reset $week" > "$HOME/.cache/devbox/claude-limits.$$" \
    && mv -f "$HOME/.cache/devbox/claude-limits.$$" "$HOME/.cache/devbox/claude-limits"
fi

RESET=$'\033[0m'
DIM=$'\033[2m'
BOLD=$'\033[1m'
RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
CYAN=$'\033[36m'

# meter LABEL PCT -> "LABEL NN%", or "NN%" for an empty LABEL; green below 50,
# yellow below 80, red from 80.
meter() {
  local pct c
  pct=$(awk -v p="$2" 'BEGIN{printf "%.0f", p+0}')
  if (( pct >= 80 )); then c=$RED
  elif (( pct >= 50 )); then c=$YELLOW
  else c=$GREEN
  fi
  printf '%s%s%s%%%s' "$c" "${1:+$1 }" "$pct" "$RESET"
}

segments=()

# Directory and git state. Project dir is where claude started: a repo, or a
# project root holding repos. cwd may be below it.
dir=${cwd:-$PWD}
root=${project_dir:-$dir}
# Name the repo being worked on, not the project: the repo under the project
# root that cwd is in, or the project itself when it is a repo (the old
# layout). At a project root holding repos, no name.
name=$(basename "$root")
if [ ! -e "$root/.git" ]; then
  case $dir in
    "$root"/*) rel=${dir#"$root"/}; name=${rel%%/*} ;;
    "$root") name="" ;;
    *) name=$(basename "$dir") ;;
  esac
fi
(( ${#name} > 7 )) && name="...${name: -7}"
seg=${name:+${BOLD}${name}${RESET}}
if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  branch=$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null \
    || git -C "$dir" rev-parse --short HEAD 2>/dev/null)
  dirty=""
  [ -n "$(git -C "$dir" status --porcelain 2>/dev/null | head -1)" ] && dirty="${YELLOW}*${RESET}"
  ab=""
  if counts=$(git -C "$dir" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null); then
    behind=${counts%%	*}; ahead=${counts##*	}
    [ "${ahead:-0}" -gt 0 ] && ab+=" ↑$ahead"
    [ "${behind:-0}" -gt 0 ] && ab+=" ↓$behind"
  fi
  seg+=" ${CYAN}⎇ ${branch}${RESET}${dirty}${ab:+${DIM}${ab}${RESET}}"
else
  # A project root holding several repos: how many, and how many have changes.
  n=0 nd=0
  for g in "$dir"/*/.git; do
    [ -e "$g" ] || continue
    n=$((n + 1))
    [ -n "$(git -C "${g%/.git}" status --porcelain 2>/dev/null | head -1)" ] && nd=$((nd + 1))
  done
  if [ "$n" -gt 0 ]; then
    seg+=" ${CYAN}${n} repos${RESET}"
    [ "$nd" -gt 0 ] && seg+=" ${YELLOW}${nd}*${RESET}"
  fi
fi
seg=${seg# }
[ -n "$seg" ] && segments+=("$seg")

# Remote Control: green when the session can be driven from claude.ai or the
# phone, red when it cannot.
if [ -n "${CLAUDE_CODE_BRIDGE_SESSION_ID:-}" ]; then
  segments+=("${GREEN}RC${RESET}")
else
  segments+=("${RED}RC${RESET}")
fi

# Cloud identities: gcp:NAME and aws:NAME, NAME being the gcloud config or AWS
# account directory `devbox project` gave the session, else default. Shown when
# it has credentials (ADC, which devbox and the SDKs use, or an access key); red
# when a project names one that has none yet, the usual cause of auth errors.
# cloud LABEL NAME CREDS EXPLICIT
cloud() {
  if [ -s "$3" ] && { [ "$1" != aws ] || grep -qE '^aws_access_key_id *= *[^ ]' "$3"; }; then
    segments+=("$1:$2")
  elif [ -n "$4" ]; then
    segments+=("${RED}$1:$2${RESET}")
  fi
}
if [ -n "${CLOUDSDK_CONFIG:-}" ]; then
  cloud gcp "$(basename "$CLOUDSDK_CONFIG")" "$CLOUDSDK_CONFIG/application_default_credentials.json" 1
else
  cloud gcp default "$HOME/.config/gcloud/application_default_credentials.json" ""
fi
if [ -n "${AWS_SHARED_CREDENTIALS_FILE:-}" ]; then
  cloud aws "$(basename "$(dirname "$AWS_SHARED_CREDENTIALS_FILE")")" "$AWS_SHARED_CREDENTIALS_FILE" 1
else
  cloud aws default "$HOME/.aws/credentials" ""
fi

# Box: the pet disk. The email alert fires at disk_used_pct, 85 by default.
if [ -d /srv/code ] && mountpoint -q /srv/code 2>/dev/null; then
  used=$(df -P /srv/code 2>/dev/null | awk 'NR==2 {sub(/%/, "", $5); print $5}')
  [ -n "$used" ] && segments+=("$(meter "" "$used")")
fi

# Usage meters: context, 5h, 7d. One segment so they sit a single space apart.
usage=()
[ -n "$ctx_used" ] && usage+=("$(meter "" "$ctx_used")")
[ -n "$five" ] && usage+=("$(meter "" "$five")")
[ -n "$week" ] && usage+=("$(meter "" "$week")")
(( ${#usage[@]} )) && segments+=("${usage[*]}")

# Session cost, wall time, lines changed.
sess=""
[ -n "$cost" ] && sess+=$(awk -v c="$cost" 'BEGIN{printf "$%.2f", c+0}')
if [ -n "$dur_ms" ]; then
  mins=$(( ${dur_ms%.*} / 60000 ))
  if (( mins >= 60 )); then t="$(( mins / 60 ))h$(( mins % 60 ))m"; else t="${mins}m"; fi
  sess+="${sess:+ }$t"
fi
if [ -n "$added$removed" ]; then
  sess+="${sess:+ }+${added:-0}/-${removed:-0}"
fi
[ -n "$sess" ] && segments+=("${DIM}${sess}${RESET}")

[ -n "$model" ] && segments+=("${DIM}${model}${RESET}")

out=""
for s in "${segments[@]}"; do
  out+="${out:+  }$s"
done
printf '%s' "$out"
