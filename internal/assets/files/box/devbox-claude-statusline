#!/bin/bash
# Claude Code statusLine. On the box, managed settings point every session at
# /usr/local/bin/devbox-claude-statusline; in the devbox repo, .claude/statusline.sh
# is a symlink to this file. Reads the session JSON on stdin and prints one line.
#
#   acme-api ⎇ main* ↑1  client-a@acme-prod/europe-west2  adc ✓ gcloud me@example.com
#   code [███░░░░░░░] 31%  Ctx [███░░░░░░░] 31%  5h [█░░░░░░░░░] 12%  7d [██░░░░░░░░] 20%  $0.42 12m +80/-12  Fable 5.1
#
# Segments, each omitted when it does not apply, never an error:
#   - directory and git state
#   - on the laptop, in the devbox repo: the box devbox.yaml targets
#   - in a project session on the box: the gcloud config, project and region
#     that `devbox project` gave the session
#   - whether Application Default Credentials exist in that gcloud config,
#     which is what devbox and most SDKs authenticate with; the CLI's own
#     account is shown when the ADC file does not name one
#   - on the box: how full /srv/code is (the alert fires at disk_used_pct)
#   - context window and rate-limit meters, session cost, wall time and lines
#     changed, and the model
# Needs jq.

input=$(cat)

# One jq call for every field. Missing fields come back empty. The separator
# is the ASCII unit separator: a whitespace IFS would collapse empty fields.
IFS=$'\x1f' read -r model cwd project_dir ctx_used five week cost dur_ms added removed <<<"$(
  jq -r '[
    (.model.display_name // ""),
    (.workspace.current_dir // .cwd // ""),
    (.workspace.project_dir // ""),
    (.context_window.used_percentage // ""),
    (.rate_limits.five_hour.used_percentage // ""),
    (.rate_limits.seven_day.used_percentage // ""),
    (.cost.total_cost_usd // ""),
    (.cost.total_duration_ms // ""),
    (.cost.total_lines_added // ""),
    (.cost.total_lines_removed // "")
  ] | map(tostring) | join("\u001f")' <<<"$input"
)"

RESET=$'\033[0m'
DIM=$'\033[2m'
BOLD=$'\033[1m'
RED=$'\033[31m'
YELLOW=$'\033[33m'
CYAN=$'\033[36m'
WIDTH=10

# render_bar PCT WIDTH -> sub-character-resolution block bar (eighths).
render_bar() {
  local pct width eighths total_eighths full rem bar i
  pct=$(awk -v p="$1" 'BEGIN{p=p+0; if(p<0)p=0; if(p>100)p=100; printf "%.0f", p}')
  width="$2"
  eighths=(" " "▏" "▎" "▍" "▌" "▋" "▊" "▉" "█")
  total_eighths=$(( pct * width * 8 / 100 ))
  full=$(( total_eighths / 8 ))
  rem=$(( total_eighths % 8 ))
  bar=""
  for ((i = 0; i < full; i++)); do bar+="█"; done
  if (( rem > 0 && full < width )); then
    bar+="${eighths[$rem]}"
    full=$((full + 1))
  fi
  for ((i = full; i < width; i++)); do bar+="░"; done
  printf '%s' "$bar"
}

# color_for PCT -> ANSI color escalating green -> yellow -> red.
color_for() {
  local pct
  pct=$(awk -v p="$1" 'BEGIN{p=p+0; printf "%.0f", p}')
  if (( pct >= 80 )); then printf '\033[31m'
  elif (( pct >= 50 )); then printf '\033[33m'
  else printf '\033[32m'
  fi
}

pct_fmt() { awk -v p="$1" 'BEGIN{printf "%.0f", p+0}'; }

# meter LABEL PCT -> "LABEL [bar] NN%" in the colour for PCT.
meter() {
  local c
  c=$(color_for "$2")
  printf '%s%s [%s] %s%%%s' "$c" "$1" "$(render_bar "$2" "$WIDTH")" "$(pct_fmt "$2")" "$RESET"
}

# yaml_scalar KEY FILE -> the top-level scalar for KEY, comment and quotes stripped.
yaml_scalar() {
  awk -v k="$1" '
    $0 ~ "^" k ":" {
      sub("^" k ":[[:space:]]*", ""); sub(/[[:space:]]+#.*$/, ""); sub(/^#.*$/, "")
      gsub(/^["'"'"']|["'"'"']$/, ""); print; exit
    }' "$2" 2>/dev/null
}

segments=()

# Directory and git state. Project dir is the repo; cwd may be a subdirectory.
dir=${cwd:-$PWD}
root=${project_dir:-$dir}
seg="${BOLD}$(basename "$root")${RESET}"
if [ "$dir" != "$root" ]; then
  seg+="${DIM}/${dir#"$root"/}${RESET}"
fi
if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  branch=$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null \
    || git -C "$dir" rev-parse --short HEAD 2>/dev/null)
  dirty=""
  [ -n "$(git -C "$dir" status --porcelain 2>/dev/null | head -1)" ] && dirty="${YELLOW}*${RESET}"
  ab=""
  if counts=$(git -C "$dir" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null); then
    behind=${counts%%	*}; ahead=${counts##*	}
    [ "${ahead:-0}" -gt 0 ] && ab+=" ↑$ahead"
    [ "${behind:-0}" -gt 0 ] && ab+=" ↓$behind"
  fi
  seg+=" ${CYAN}⎇ ${branch}${RESET}${dirty}${ab:+${DIM}${ab}${RESET}}"
fi
segments+=("$seg")

# Laptop, devbox repo: the box devbox.yaml targets. The binary reads
# ./devbox.yaml by default, so this is what `./devbox apply` would touch.
if [ -f "$root/devbox.yaml" ] && [ -f "$root/devbox.example.yaml" ]; then
  name=$(yaml_scalar name "$root/devbox.yaml")
  project=$(yaml_scalar project_id "$root/devbox.yaml")
  zone=$(yaml_scalar zone "$root/devbox.yaml")
  segments+=("${DIM}▸${RESET} ${name:-devbox}@${project:-?}/${zone:-europe-west4-a}")
fi

# Box, project session: the identity `devbox project` gave this session.
# CLOUDSDK_CONFIG is the gcloud config directory, so its name is the identity.
if [ -n "${CLOUDSDK_CONFIG:-}" ]; then
  seg="$(basename "$CLOUDSDK_CONFIG")"
  [ -n "${CLOUDSDK_CORE_PROJECT:-}" ] && seg+="@${CLOUDSDK_CORE_PROJECT}"
  [ -n "${CLOUDSDK_COMPUTE_REGION:-}" ] && seg+="/${CLOUDSDK_COMPUTE_REGION}"
  segments+=("$seg")
fi

# Application Default Credentials: what devbox and the SDKs authenticate as,
# not the CLI's login. Missing ADC is the usual cause of auth errors.
gcloud_dir="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"
adc="$gcloud_dir/application_default_credentials.json"
if [ -f "$adc" ]; then
  # User ADC usually leaves account empty. Fall back to the CLI's active
  # account in the same config, normally the same login, and say so.
  account=$(jq -r '.account // .client_email // empty' "$adc" 2>/dev/null)
  if [ -n "$account" ]; then
    segments+=("${DIM}adc${RESET} ${account}")
  else
    cfg="${CLOUDSDK_ACTIVE_CONFIG_NAME:-$(cat "$gcloud_dir/active_config" 2>/dev/null)}"
    cli=$(awk -F' *= *' '/^account/ {print $2; exit}' "$gcloud_dir/configurations/config_${cfg:-default}" 2>/dev/null)
    segments+=("${DIM}adc${RESET} ✓${cli:+ ${DIM}gcloud ${cli}${RESET}}")
  fi
else
  segments+=("${RED}no ADC${RESET}")
fi

# Box: the pet disk. The email alert fires at disk_used_pct, 85 by default.
if [ -d /srv/code ] && mountpoint -q /srv/code 2>/dev/null; then
  used=$(df -P /srv/code 2>/dev/null | awk 'NR==2 {sub(/%/, "", $5); print $5}')
  [ -n "$used" ] && segments+=("$(meter code "$used")")
fi

# Usage meters.
[ -n "$ctx_used" ] && segments+=("$(meter Ctx "$ctx_used")")
[ -n "$five" ] && segments+=("$(meter 5h "$five")")
[ -n "$week" ] && segments+=("$(meter 7d "$week")")

# Session cost, wall time, lines changed.
sess=""
[ -n "$cost" ] && sess+=$(awk -v c="$cost" 'BEGIN{printf "$%.2f", c+0}')
if [ -n "$dur_ms" ]; then
  mins=$(( ${dur_ms%.*} / 60000 ))
  if (( mins >= 60 )); then t="$(( mins / 60 ))h$(( mins % 60 ))m"; else t="${mins}m"; fi
  sess+="${sess:+ }$t"
fi
if [ -n "$added$removed" ]; then
  sess+="${sess:+ }+${added:-0}/-${removed:-0}"
fi
[ -n "$sess" ] && segments+=("${DIM}${sess}${RESET}")

[ -n "$model" ] && segments+=("${DIM}${model}${RESET}")

out=""
for s in "${segments[@]}"; do
  out+="${out:+  }$s"
done
printf '%s' "$out"
