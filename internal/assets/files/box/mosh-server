#!/bin/bash
# /usr/local/bin/mosh-server: the real one, with a timeout. A mosh-server whose
# client has vanished for good otherwise runs forever. The timeout is generous so
# a laptop that sleeps through lunch or the night can still roam back in: the
# clock stops while the box itself is suspended, so this counts only hours the
# box spent awake without hearing from the client (a long Claude turn, say). An
# orphan holds a few MB and no keyboard, so it never keeps the box up meanwhile.
export MOSH_SERVER_NETWORK_TMOUT=${MOSH_SERVER_NETWORK_TMOUT:-259200}
exec /usr/bin/mosh-server "$@"
