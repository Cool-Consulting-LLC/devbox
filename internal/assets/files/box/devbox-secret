#!/bin/bash
# devbox-secret NAME [VERSION]: print a Secret Manager secret, read with the box's own identity.
set -euo pipefail
md() { curl -fsS -H 'Metadata-Flavor: Google' "http://metadata.google.internal/computeMetadata/v1/$1"; }
tok=$(md instance/service-accounts/default/token | jq -r .access_token)
curl -fsS -H "Authorization: Bearer $tok" \
  "https://secretmanager.googleapis.com/v1/projects/$(md project/project-id)/secrets/$1/versions/${2:-latest}:access" \
  | jq -r .payload.data | base64 -d
